<?xml version="1.0"?>
<!--
  scout.urdf.xacro — Главный файл модели робота Scout Mini
  Подключает все компоненты: шасси, колёса, сенсоры, плагины Gazebo.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scout_mini">

  <!-- ============================================================ -->
  <!-- ПАРАМЕТРЫ РОБОТА                                              -->
  <!-- ============================================================ -->

  <!-- Шасси -->
  <xacro:property name="chassis_length" value="0.6"/>     <!-- Длина корпуса, м -->
  <xacro:property name="chassis_width" value="0.4"/>      <!-- Ширина корпуса, м -->
  <xacro:property name="chassis_height" value="0.2"/>     <!-- Высота корпуса, м -->
  <xacro:property name="chassis_mass" value="12.0"/>      <!-- Масса корпуса, кг -->
  <xacro:property name="chassis_z_offset" value="0.125"/> <!-- Высота центра корпуса над землёй, м -->






  <!-- Колёса (2 ведущих на центральной оси) -->
  <xacro:property name="wheel_radius" value="0.075"/>     <!-- Радиус колеса, м -->
  <xacro:property name="wheel_width" value="0.04"/>       <!-- Ширина колеса, м -->
  <xacro:property name="wheel_mass" value="0.5"/>         <!-- Масса одного колеса, кг -->
  <xacro:property name="wheel_separation" value="0.44"/>  <!-- Колея: между центрами колёс, м -->

  <!-- Сферические опорные катки (трение ~0) -->
  <xacro:property name="caster_radius" value="0.035"/>    <!-- Радиус сферы-катка, м -->
  <xacro:property name="caster_x_offset" value="0.2"/>    <!-- Вынос катков вперёд/назад, м -->
  <xacro:property name="caster_mass" value="0.1"/>        <!-- Масса катка, кг -->





  <!-- Шасси и колёса -->
  <xacro:include filename="$(find scout_description)/urdf/base.xacro"/>

  <!-- Сенсоры (ВСЕ ВКЛЮЧЕНЫ) -->
  <xacro:include filename="$(find scout_description)/urdf/sensors/lidar.xacro"/>
  <xacro:include filename="$(find scout_description)/urdf/sensors/depth_camera.xacro"/>
  <xacro:include filename="$(find scout_description)/urdf/sensors/imu.xacro"/>
  <xacro:include filename="$(find scout_description)/urdf/sensors/gps.xacro"/>

  <!-- Плагины Gazebo -->
  <xacro:include filename="$(find scout_description)/urdf/gazebo/gz_plugins.xacro"/>

</robot>
