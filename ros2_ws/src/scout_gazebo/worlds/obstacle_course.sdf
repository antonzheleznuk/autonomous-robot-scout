<?xml version="1.0"?>
<!--
  obstacle_course.sdf — Мир симуляции для навигации Scout Mini
  
  Арена: 20×20 м, плоская поверхность
  Препятствия: 3 куба, 2 цилиндра, 1 L-стена (2 сегмента)
  Зоны: старт (A) и финиш (B) с визуальными маркерами
  GPS: привязка к координатам Москвы (55.7558°N, 37.6173°E)
-->
<sdf version="1.10">
  <world name="obstacle_course">

    <!-- ======================================================== -->
    <!-- ФИЗИКА                                                     -->
    <!-- ======================================================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <!-- Шаг физики 1 мс = 1000 Гц. Высокая точность, но требует
           больше CPU. Для навигации можно увеличить до 0.002-0.005 -->
      <real_time_factor>1.0</real_time_factor>
      <!-- 1.0 = симуляция в реальном времени -->
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ======================================================== -->
    <!-- СИСТЕМНЫЕ ПЛАГИНЫ GAZEBO                                   -->
    <!-- Без этих плагинов симулятор не будет работать!             -->
    <!-- ======================================================== -->

    <!-- Физический движок (DART по умолчанию в Harmonic) -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <!-- Обработка команд пользователя (спавн, удаление, перемещение) -->
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Трансляция сцены в GUI (без него Gazebo не покажет картинку) -->
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Система сенсоров (LiDAR, камера, IMU, GPS).
         Наша архитектура: ogre2 + серверный llvmpipe
         (LIBGL_ALWAYS_SOFTWARE=1 в gazebo.launch.py) — единственная
         комбинация с корректным depth на VMware SVGA3D -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU плагин (обработка данных инерциального датчика) -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- GPS/NavSat плагин (конвертация позиции в GPS-координаты) -->
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <!-- Плагин контакта (для определения столкновений) -->
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ======================================================== -->
    <!-- GPS-ПРИВЯЗКА МИРА (spherical_coordinates)                  -->
    <!-- ======================================================== -->
    <!-- Центр мира (0,0,0) = Москва (условно).
         Heading 0° = ось X мира направлена на Восток (ENU). -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <!-- ENU = East-North-Up (стандарт для GPS в робототехнике) -->
      <latitude_deg>55.755826</latitude_deg>
      <longitude_deg>37.617300</longitude_deg>
      <elevation>150.0</elevation>
      <!-- Высота над уровнем моря, м (Москва ~150 м) -->
      <heading_deg>0</heading_deg>
      <!-- 0° = X на Восток, Y на Север -->
    </spherical_coordinates>

    <!-- ======================================================== -->
    <!-- ОСВЕЩЕНИЕ                                                  -->
    <!-- ======================================================== -->

    <!-- Солнце (направленный свет) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -0.8</direction>
      <!-- Направление лучей (утро, солнце на юго-востоке) -->
    </light>

    <!-- Рассеянный свет (чтобы тени не были полностью чёрными) -->
    <light type="directional" name="ambient_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.3 0.3 0.35 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.5 -0.3 -0.5</direction>
    </light>

    <!-- ======================================================== -->
    <!-- ЗЕМЛЯ (Ground Plane)                                       -->
    <!-- ======================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <!-- static = не двигается и не падает под гравитацией -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <!-- Нормаль вверх = горизонтальная плоскость -->
              <size>100 100</size>
              <!-- 100×100 м (больше арены, чтобы робот не съехал) -->
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>



            <ambient>0.42 0.44 0.48 1</ambient>
            <diffuse>0.42 0.44 0.48 1</diffuse>
            <!-- Тёмный сине-серый (раздел 9): контраст с роботом,
                 препятствиями и жёлтой границей арены -->


          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ПРЕПЯТСТВИЕ 1: Большой куб (1.0 × 1.0 × 1.0 м)           -->
    <!-- Позиция: (3.0, 2.0) — на пути от A к B                    -->
    <!-- ======================================================== -->
    <model name="obstacle_cube_1">
      <static>true</static>
      <pose>3.0 2.0 0.5 0 0 0</pose>
      <!-- pose = x y z roll pitch yaw; z=0.5 = центр куба высотой 1 м -->
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.0 1.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.0 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.4 0.2 1</ambient>
            <diffuse>0.7 0.4 0.2 1</diffuse>
            <!-- Кирпичный цвет -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ПРЕПЯТСТВИЕ 2: Малый куб (0.5 × 0.5 × 0.8 м)             -->
    <!-- Позиция: (-2.0, 4.0)                                      -->
    <!-- ======================================================== -->
    <model name="obstacle_cube_2">
      <static>true</static>
      <pose>-2.0 4.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
            <!-- Деревянный цвет -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ПРЕПЯТСТВИЕ 3: Широкий куб (1.5 × 0.8 × 1.2 м)           -->
    <!-- Позиция: (1.0, -3.0)                                      -->
    <!-- ======================================================== -->
    <model name="obstacle_cube_3">
      <static>true</static>
      <pose>1.0 -3.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.5 0.8 1.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.5 0.8 1.2</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <!-- Бетонный (серый) -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ПРЕПЯТСТВИЕ 4: Цилиндр (r=0.3, h=1.0 м)                  -->
    <!-- Позиция: (-4.0, -1.0)                                     -->
    <!-- ======================================================== -->
    <model name="obstacle_cylinder_1">
      <static>true</static>
      <pose>-4.0 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.7 1</ambient>
            <diffuse>0.6 0.6 0.7 1</diffuse>
            <!-- Металлический -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ПРЕПЯТСТВИЕ 5: Цилиндр (r=0.3, h=1.0 м)                  -->
    <!-- Позиция: (5.0, 5.0) — рядом с финишем                     -->
    <!-- ======================================================== -->
    <model name="obstacle_cylinder_2">
      <static>true</static>
      <pose>5.0 5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.7 1</ambient>
            <diffuse>0.6 0.6 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ПРЕПЯТСТВИЕ 6: L-стена, часть 1 (3.0 × 0.2 × 1.5 м)      -->
    <!-- Горизонтальная часть буквы "L", позиция: (-1.0, 0.0)      -->
    <!-- ======================================================== -->
    <model name="obstacle_wall_l1">
      <static>true</static>
      <pose>-1.0 0.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 0.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.5 1</ambient>
            <diffuse>0.55 0.55 0.5 1</diffuse>
            <!-- Бетонный -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ПРЕПЯТСТВИЕ 7: L-стена, часть 2 (0.2 × 2.0 × 1.5 м)      -->
    <!-- Вертикальная часть "L", позиция: (0.4, -0.9)              -->
    <!-- ======================================================== -->
    <model name="obstacle_wall_l2">
      <static>true</static>
      <pose>0.4 -0.9 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 2.0 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 2.0 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.5 1</ambient>
            <diffuse>0.55 0.55 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- МАРКЕР СТАРТА (A) — Зелёная наклейка 1×1 м, (-7.0, -7.0)  -->
    <!-- ======================================================== -->
    <model name="start_zone">
      <static>true</static>
      <!-- Наклейка 2 мм: робот стоит на земле, визуально "на площадке",
           без утопления колёс и без физической ступеньки -->
      <pose>-7.0 -7.0 0.001 0 0 0</pose>
      <link name="link">
        <!-- Нет collision — маркер не является препятствием! -->
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.0 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.1 0.7</ambient>
            <diffuse>0.1 0.8 0.1 0.7</diffuse>
            <!-- Ярко-зелёный, полупрозрачный -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- МАРКЕР ФИНИША (B) — Красная наклейка 1×1 м, (7.0, 7.0)    -->
    <!-- ======================================================== -->
    <model name="finish_zone">
      <static>true</static>
      <pose>7.0 7.0 0.001 0 0 0</pose>
      <link name="link">
        <!-- Нет collision — маркер не является препятствием! -->
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.0 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 0.7</ambient>
            <diffuse>0.9 0.1 0.1 0.7</diffuse>
            <!-- Ярко-красный, полупрозрачный -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- ГРАНИЦЫ АРЕНЫ (визуальные, не физические)                  -->
    <!-- Тонкие линии по периметру 20×20 м для ориентира            -->
    <!-- ======================================================== -->
    <model name="arena_border">
      <static>true</static>
      <pose>0 0 0.003 0 0 0</pose>
      <link name="link">
        <!-- Северная граница -->
        <visual name="border_north">
          <pose>0 10 0 0 0 0</pose>
          <geometry><box><size>20 0.05 0.005</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
        <!-- Южная граница -->
        <visual name="border_south">
          <pose>0 -10 0 0 0 0</pose>
          <geometry><box><size>20 0.05 0.005</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
        <!-- Восточная граница -->
        <visual name="border_east">
          <pose>10 0 0 0 0 0</pose>
          <geometry><box><size>0.05 20 0.005</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
        <!-- Западная граница -->
        <visual name="border_west">
          <pose>-10 0 0 0 0 0</pose>
          <geometry><box><size>0.05 20 0.005</size></box></geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
