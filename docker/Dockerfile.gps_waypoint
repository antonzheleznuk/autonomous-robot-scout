# ============================================================
# Dockerfile.gps_waypoint — GPS-навигация и управление миссией
# Кастомные C++ ноды для конвертации GPS → map и следования
# по waypoints
# ============================================================

FROM scout:base

# --- Установка зависимостей для GPS-навигации ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-nav2-msgs \
    ros-${ROS_DISTRO}-nav2-waypoint-follower \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-tf2-geometry-msgs \
    ros-${ROS_DISTRO}-geographic-msgs \
    libgeographiclib-dev \
    geographiclib-tools \
    && rm -rf /var/lib/apt/lists/*

# Пояснение:
# nav2-msgs            — типы сообщений Nav2 (NavigateToPose action и др.)
# geographic-msgs      — типы для GPS-координат (GeoPoint, GeoPose)
# libgeographiclib-dev  — C++ библиотека геодезии (нодами НЕ используется:
#                        конвертация — собственная equirectangular-проекция;
#                        оставлена для геодезических задач этапа 2)

# --- Копирование исходного кода GPS-нод ---
COPY ros2_ws/src/scout_gps_waypoint /ros2_ws/src/scout_gps_waypoint
COPY ros2_ws/src/scout_navigation /ros2_ws/src/scout_navigation

# --- Сборка ---
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && cd /ros2_ws \
    && colcon build \
        --packages-select scout_gps_waypoint scout_navigation \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
    || echo "Сборка пропущена (C++ ноды ещё не написаны)"

CMD ["bash"]
